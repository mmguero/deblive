#!/bin/bash

export LC_ALL=C.UTF-8
export LANG=C.UTF-8

python3 -m pip install --ignore-installed --no-compile --no-cache-dir --break-system-packages --force-reinstall --upgrade \
  arrow \
  beautifulsoup4 \
  black \
  cachetools \
  clamd \
  cleanvid \
  colorama \
  colored \
  cryptography \
  customtkinter \
  Cython \
  dataset \
  dateparser \
  debinterface \
  defopt \
  dhcpwn \
  dominate \
  dtrx \
  entrypoint2 \
  git+https://github.com/badele/gitcheck.git \
  git-up \
  habu \
  humanhash3 \
  libarchive-c \
  'mmguero[fire]>=2.2' \
  monkeyplug \
  montag-cleaner \
  more-itertools \
  netmiko \
  ordered-set \
  pandas \
  patool \
  Pillow \
  podman-compose \
  psutil \
  py-cui \
  pycryptodome \
  pyinputplus \
  pyshark \
  python-dateutil \
  python-dotenv \
  python-magic \
  python-rapidjson \
  python-slugify \
  pythondialog \
  git+https://github.com/ponty/pyunpack \
  pywinrm \
  pyyaml \
  requests \
  rich \
  rpyc \
  ruamel.yaml \
  scanless \
  scapy \
  sh \
  snoop \
  stackprinter \
  stream-zip \
  textual \
  tldr \
  tqdm \
  trackerjacker \
  typer \
  urllib3 \
  yt-dlp \
  yubikey-manager

git clone --depth 1 https://github.com/MarkBaggett/MarkBaggett /opt/MarkBaggett && \
  rm -rf /opt/MarkBaggett/.git
